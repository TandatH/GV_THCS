{
  "name": "@school/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./discipline": {
      "types": "./dist/discipline.d.ts",
      "import": "./dist/discipline.js",
      "default": "./dist/discipline.js"
    },
    "./payroll": {
      "types": "./dist/payroll.d.ts",
      "import": "./dist/payroll.js",
      "default": "./dist/payroll.js"
    },
    "./exam": {
      "types": "./dist/exam.d.ts",
      "import": "./dist/exam.js",
      "default": "./dist/exam.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "zod": "^4.0.5" },
  "devDependencies": { "typescript": "^5.8.3" }
}
